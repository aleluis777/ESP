# Target: ESP32 comun (no S3). Si "idf.py set-target esp32" no lo dejo asi,
# correlo a mano antes del primer build.
CONFIG_IDF_TARGET="esp32"

# 240MHz -- mismo default que usa el Arduino IDE para ESP32 Dev Module (el
# entorno donde ya funcionaba bien labgeo2025.ino/LABGEO2.ino). El default de
# ESP-IDF es 160MHz; dial_caliper.c tiene un bucle de asentamiento de 2000
# ciclos de CPU crudos (no calibrados a microsegundos) antes de leer DATA --
# a 160MHz esos 2000 ciclos representan una ventana de tiempo real distinta
# a la que tenia el .ino probado a 240MHz, lo que encaja con las lecturas de
# dial que salen mal de forma intermitente.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Particiones propias: agrega una particion SPIFFS ("storage") para guardar
# el historial de las corridas, mas ota_0/ota_1/otadata para poder actualizar
# el firmware por OTA (POST /ota en servidor_web.c) en vez de solo por USB --
# ver partitions.csv. La tabla ocupa ~3.8MB de los 4MB del modulo (confirmado
# con el usuario), por eso hace falta declarar flash de 4MB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Rollback automatico: si el firmware que se subio por /ota no llega a
# confirmarse como valido (ver esp_ota_mark_app_valid_cancel_rollback() en
# app_main2.c) -- por ejemplo, crashea o se cuelga apenas arranca -- el
# bootloader vuelve solo al firmware anterior en el proximo reset/watchdog,
# en vez de dejar el equipo baneado con un firmware roto.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# WebSocket en esp_http_server (lo usa servidor_web.c para /ws).
CONFIG_HTTPD_WS_SUPPORT=y

# Default (10) se quedaba corto: esp_http_server ya usa 3 sockets para si
# mismo, y una carga de pagina normal (index.html + style.css + equipo.png,
# sin keep-alive) mas el WS facil llega a 4-5 conexiones simultaneas, dejando
# el WS sin lugar. Con 16 sobra margen (ver max_open_sockets en servidor_web.c).
CONFIG_LWIP_MAX_SOCKETS=16

# Ethernet: modulo W5500 por SPI, pines confirmados contra labgeo2025.ino /
# LinaresETH.cpp. Apagamos el EMAC interno (viene prendido por defecto y
# rompe el init si no hay un PHY RMII real conectado) y prendemos el modulo
# SPI con el W5500 explicitamente.
CONFIG_ETHERNET_INTERNAL_SUPPORT=n
CONFIG_ETHERNET_SPI_SUPPORT=y
CONFIG_ETHERNET_SPI_DEV0_W5500=y
CONFIG_ETHERNET_SPI_HOST=2
CONFIG_ETHERNET_SPI_SCLK_GPIO=18
CONFIG_ETHERNET_SPI_MOSI_GPIO=23
CONFIG_ETHERNET_SPI_MISO_GPIO=19
CONFIG_ETHERNET_SPI_CS0_GPIO=17
# INT cableado a GPIO16/AA3 (cable de 6cm, separado del cableado de los
# diales; se movio de GPIO26 a GPIO16 porque GPIO26 quedo asignado a CLK2).
# Con INT >= 0 el driver W5500 (esp_eth_mac_w5500.c) pasa a modo interrupcion
# solo y activa el pull-up interno del pin + GPIO_INTR_NEGEDGE el mismo, no
# hace falta nada mas de nuestro lado. Antes estaba en -1 (modo polling).
CONFIG_ETHERNET_SPI_INT0_GPIO=16
CONFIG_ETHERNET_SPI_PHY_RST0_GPIO=5
