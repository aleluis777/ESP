# Mismo modulo que "blink" (ESP32-S3-WROOM-1-N16R8, 16MB flash + 8MB PSRAM
# Octal) -- ajustar si braindlab termina corriendo en otra placa. Sin esto,
# sdkconfig se regenera con los defaults genericos de ESP-IDF (sin PSRAM) y
# el panel RGB + el buffer de LVGL en PSRAM fallan con "no mem for frame buffer".
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Tamanos de fuente Montserrat que usa el dashboard (main/ui_dashboard.c)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
