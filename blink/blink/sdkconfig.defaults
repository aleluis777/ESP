# Modulo confirmado: ESP32-S3-WROOM-1-N16R8 (16MB flash + 8MB PSRAM Octal).
# Esta config se habia perdido en algun momento (el sdkconfig se regenero
# solo con los defaults genericos de ESP-IDF, que no traen PSRAM habilitada)
# -- causaba "no mem for frame buffer" al crear el panel RGB, porque
# blink.c pide el frame buffer (800x480, ~750KB) y el buffer de LVGL en
# PSRAM (fb_in_psram/buff_spiram = true en blink.c), y sin esto no hay
# donde alojarlos (la SRAM interna del ESP32-S3 no alcanza).
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
